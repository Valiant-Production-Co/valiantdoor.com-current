{
  "version": 2,
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_BUILDER_API_KEY": "@builder_api_key",
    "INDEXNOW_HOST": "@indexnow_host",
    "INDEXNOW_KEY": "@indexnow_key",
    "INDEXNOW_KEY_LOCATION": "@indexnow_key_location",
    "INDEXNOW_WEBHOOK_SECRET": "@indexnow_webhook_secret"
  },
  "redirects": [
    {
      "source": "/services/emergency",
      "destination": "/emergency-garage-door-repair",
      "permanent": true
    },
    {
      "source": "/services/installations",
      "destination": "/garage-door-installation",
      "permanent": true
    }
  ]
}
